# --- Primee: never commit private data -------------------------------------
# Local, machine specific configuration (paths, chosen providers).
config/*.local.toml
*.local.toml

# Secret material. Primee does not create these, but make it impossible to
# commit one by accident.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
/secrets/
/credentials/

# The real Vault must live outside this repository. These are a second line of
# defence in case someone points it at the working tree.
#
# NOTE: these patterns are anchored with a leading "/" so they match only a
# vault at the repository root. An unanchored "vault/" would also match
# src/primee/skills/vault/, silently excluding the Vault skill's own source.
/vault/
/Vault/
/PrimeeVault/

# Primee runtime state: audit log, caches, snapshots.
/state/
*.jsonl
!tests/fixtures/**/*.jsonl

# --- Primee Memory: the real personal Vault -------------------------------
# The Vault holds your actual notes, knowledge and outputs. It lives on your own
# computer, outside this repository, and is never committed, pushed, uploaded to
# a browser development environment, used in tests, logged or published.
#
# The repository contains only: Vault implementation code, documentation, the
# fictional template Vault under templates/, synthetic fixtures and tests.
/vault/
/Vault/
/PrimeeVault/
/primee-vault/
/my-vault/
*.vault/
**/vault-local/
**/PRIMEE_VAULT/

# Anything a real Vault would carry, wherever it was accidentally placed.
**/raw/**/*.md
**/wiki/**/*.md
**/outputs/**/*.md
!templates/**
!tests/**
!docs/**

# Locally downloaded models and temporary audio for future Primee steps.
/models/
*.gguf
*.safetensors
*.onnx
*.bin
/audio/
*.wav
*.mp3
*.m4a
*.ogg
*.flac

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env/
.pytest_cache/
.coverage
htmlcov/

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Primee Voice (Step Three) ---------------------------------------------
# The isolated speech runtime and every speech model live outside Git. The
# Windows setup tool writes only to these places and to *.local.toml.
/.venv-voice/
/.venv-*/
/voice-runtime/
*.onnx.json
/benchmarks/
/haaniye-benchmark-*/
*.manifest.json
!tests/fixtures/**/*.manifest.json
